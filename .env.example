# AeroTrack Sentinel — Environment Variables
# Copy this file to .env.local and fill in the values

# Private key for the wallet that creates entities on Arkiv (server-side only)
# Get testnet funds at: https://braga.hoodi.arkiv.network/faucet/
PRIVATE_KEY=0x_your_private_key_here

# Arkiv Testnet (Braga) — RPC endpoint
NEXT_PUBLIC_ARKIV_RPC=https://braga.hoodi.arkiv.network/rpc

# Project namespace — unique slug to isolate your entities in the shared Arkiv DB
PROJECT_SLUG=aerotrack-sentinel